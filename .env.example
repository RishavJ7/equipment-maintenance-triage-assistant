# Required for the AI workflow: set GROQ_API_KEY (recommended) or ANTHROPIC_API_KEY.
# Without a key the app still runs deterministic rules and shows a template work order.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Anthropic Claude configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

AI_TIMEOUT_SECONDS=45
DB_PATH=data/triage.db
